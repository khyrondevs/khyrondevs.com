# ==============================================================================
# Khyron Devs Flagship Site — Environment Configuration
# ==============================================================================

# Contact Form Email Dispatch Configuration (Brevo REST API)
# Where should incoming client inquiries be sent?
CONTACT_RECIPIENT_EMAIL=enquiries@khyrondevs.com

# ------------------------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email API
# Sign up / Login at https://app.brevo.com
# Grab your API key from: Settings -> SMTP & API -> API Keys (Generate a new API key)
# Free tier includes 300 emails/day (9,000/month).
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your_api_key_here
BREVO_SENDER_NAME="Khyron Devs Inquiries"
BREVO_SENDER_EMAIL=enquiries@khyrondevs.com

# (Optional) Brevo Dashboard Template IDs (Synchronized via `npm run email:sync` or fallback to inline templates)
BREVO_CLIENT_TEMPLATE_ID=1
BREVO_TEAM_TEMPLATE_ID=2
BREVO_REPLY_TEMPLATE_ID=3

# ------------------------------------------------------------------------------
# Cryptographic Security & Reply Studio Authentication
# Required in production. Minimum 32-character random high-entropy secret.
# Used for HMAC-SHA256 signature and tamper-proof session cookie encryption.
# ------------------------------------------------------------------------------
REPLY_SIGNING_SECRET=generate_a_random_32_character_or_longer_secret_key_here

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Anti-Bot & DDoS Protection (Free Tier)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Site
# When provided, activates invisible / managed interactive challenge on contact form.
# When omitted, gracefully falls back to Invisible Honeypot + IP Rate Limiting.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
