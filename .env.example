# ==============================================================================
# Krypton Company Site — Environment Configuration
# ==============================================================================

# Contact Form Email Dispatch Configuration (Brevo REST API)
# Where should incoming client inquiries be sent?
CONTACT_RECIPIENT_EMAIL=abc@xyz.com

# ------------------------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email API
# Sign up / Login at https://app.brevo.com
# Grab your API key from: Settings -> SMTP & API -> API Keys (Generate a new API key)
# Free tier includes 300 emails/day (9,000/month).
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your_api_key_here
BREVO_SENDER_NAME="Krypton Inquiries"
BREVO_SENDER_EMAIL=devs.krypton@gmail.com

# (Optional) If you design a custom template in Brevo's Dashboard:
# BREVO_TEMPLATE_ID=1
